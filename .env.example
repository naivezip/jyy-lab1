# Copy to .env (in your project dir) or ~/.pa/.env and fill in.
# Provider: openai | anthropic
PA_PROVIDER=openai

# Required
PA_API_KEY=
PA_MODEL=

# Optional: point at a compatible gateway (DeepSeek, Qwen, vLLM, Ollama...).
# Leave empty to use the SDK default endpoint.
PA_BASE_URL=

# Optional overrides
# PA_MAX_TOKENS=8192
# PA_MAX_STEPS=20
# PA_CONTEXT_WINDOW=128000
# PA_SHOW_USAGE=1
